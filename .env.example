# VITA — server environment (Render → Environment). Copy to .env for local runs; never commit .env.

# --- AI proxy (one of) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Cloud (P0): Supabase project, EU region. Public values; RLS protects the data. ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# (service-role key is NOT needed by the app; keep it out of this file)

# --- Monitoring ---
SENTRY_DSN=
SENTRY_DSN_BACKEND=

# --- Backend ---
HOST=0.0.0.0
PORT=4170
VITA_DB_PATH=            # default _data/vita-backend.json
VITA_DOCTOR_KEY=         # set to require a key for doctor logins on the demo backend
